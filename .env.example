# Copy to .env (local) or set in your host's dashboard (production). NEVER commit real secrets.

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Public URL (used in password-reset emails) ---
APP_URL=http://localhost:3000

# --- First-run admin account (used ONLY when the database has no admin yet) ---
ADMIN_EMAIL=admin@chickenmart.in
ADMIN_PHONE=9000000001
ADMIN_PASSWORD=ChangeMe-Strong-Password-1
# Set to "false" in production so the demo rider/customer accounts are not created
SEED_DEMO_USERS=true

# --- Razorpay (leave empty = DEMO gateway; rzp_test_… = TEST; rzp_live_… = LIVE) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email notifications via Resend (optional) ---
RESEND_API_KEY=
EMAIL_FROM=Chicken Mart <orders@yourdomain.in>

# --- Set to "true" if your host terminates HTTPS but does not send x-forwarded-proto ---
COOKIE_SECURE=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
